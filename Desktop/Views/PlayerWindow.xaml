<Window x:Class="IPTVPlayer.Desktop.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Playing" Height="640" Width="1100"
        Background="Black" WindowStartupLocation="CenterOwner">
    <Grid>
        <vlc:VideoView x:Name="VideoView" />

        <!-- Shown until the first frame arrives, then hidden. VLC reports "buffering"
             through healthy playback, so visible progress is the trustworthy signal. -->
        <Border x:Name="StatusOverlay" Background="#CC000000" CornerRadius="10"
                Padding="24,18" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Opening stream…" FontSize="15"
                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="460"
                           TextAlignment="Center" />
                <TextBlock x:Name="StatusDetail" Foreground="#9A9AA8" FontSize="11"
                           Margin="0,8,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="460" TextAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid VerticalAlignment="Bottom" Background="#AA000000" Height="52">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                <Button x:Name="PlayPauseButton" Content="Pause" Click="OnPlayPause" Width="86" />
                <Button Content="-10s" Click="OnBack" Margin="8,0,0,0" Width="64"
                        Background="{StaticResource SurfaceAlt}" />
                <Button Content="+10s" Click="OnForward" Margin="8,0,0,0" Width="64"
                        Background="{StaticResource SurfaceAlt}" />
                <TextBlock x:Name="TimeLabel" Text="0:00" VerticalAlignment="Center"
                           Margin="16,0,0,0" Foreground="#D0D0D8" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
