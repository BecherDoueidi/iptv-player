<Window x:Class="IPTVPlayer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IPTV Player" Height="760" Width="1200"
        Background="{StaticResource Background}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Sign-in -->
        <Border x:Name="LoginPanel" Background="{StaticResource Background}">
            <Border Background="{StaticResource Surface}" CornerRadius="12" Padding="32"
                    Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Sign in" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Your details are encrypted and stored only on this PC."
                               Foreground="{StaticResource TextSecondary}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,6,0,20" />

                    <TextBlock Text="Server" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                    <TextBox x:Name="ServerBox" Margin="0,4,0,14" />

                    <TextBlock Text="Username" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                    <TextBox x:Name="UsernameBox" Margin="0,4,0,14" />

                    <TextBlock Text="Password" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                    <PasswordBox x:Name="PasswordBox" Margin="0,4,0,20" />

                    <Button x:Name="SignInButton" Content="Sign In" Click="OnSignIn" />
                    <TextBlock x:Name="LoginError" Foreground="#FF7070" FontSize="12"
                               TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Catalog -->
        <Grid x:Name="CatalogPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,14,16,10">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="MoviesTab" Content="Movies" GroupName="Kind" IsChecked="True"
                                 Checked="OnKindChanged" Foreground="{StaticResource TextPrimary}"
                                 FontSize="15" Margin="0,0,18,0" />
                    <RadioButton x:Name="SeriesTab" Content="Series" GroupName="Kind"
                                 Checked="OnKindChanged" Foreground="{StaticResource TextPrimary}"
                                 FontSize="15" Margin="0,0,18,0" />
                    <RadioButton x:Name="LiveTab" Content="Live TV" GroupName="Kind"
                                 Checked="OnKindChanged" Foreground="{StaticResource TextPrimary}"
                                 FontSize="15" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox x:Name="SearchBox" Width="260" TextChanged="OnSearchChanged" />
                    <Button Content="Refresh" Click="OnRefresh" Margin="10,0,0,0"
                            Background="{StaticResource SurfaceAlt}" />
                    <Button Content="Sign Out" Click="OnSignOut" Margin="8,0,0,0"
                            Background="{StaticResource SurfaceAlt}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource Surface}" CornerRadius="10"
                        Padding="8" Margin="0,0,12,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Sections" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" Margin="8,6,8,8" />
                        <ListBox x:Name="SectionList" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimary}"
                                 SelectionChanged="OnSectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource Surface}" CornerRadius="10" Padding="8">
                    <DockPanel>
                        <TextBlock x:Name="ItemsHeader" DockPanel.Dock="Top" Text=""
                                   FontSize="12" Foreground="{StaticResource TextSecondary}"
                                   Margin="8,6,8,8" />
                        <ListBox x:Name="ItemList" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimary}"
                                 MouseDoubleClick="OnItemActivated"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Padding="16,10">
                <TextBlock x:Name="StatusBar" Foreground="{StaticResource TextSecondary}"
                           FontSize="12" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</Window>
