<Window x:Class="IPTVPlayer.Desktop.Views.EpisodePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="560" Width="620" Background="{StaticResource Background}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Season" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" />
            <ComboBox x:Name="SeasonPicker" Width="140" SelectionChanged="OnSeasonChanged" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="10" Padding="8">
            <ListBox x:Name="EpisodeList" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextPrimary}"
                     MouseDoubleClick="OnPlay" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="OnCancel" Background="{StaticResource SurfaceAlt}" />
            <Button Content="Play" Click="OnPlay" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
